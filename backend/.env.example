# Copy to .env and fill in values. Never commit real credentials.

# Model provider: "bedrock" (default) or "openai"
MODEL_PROVIDER=bedrock

# Bedrock settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-temporary-access-key
AWS_SECRET_ACCESS_KEY=replace-with-temporary-secret-key
AWS_SESSION_TOKEN=replace-with-temporary-session-token
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# OpenAI-compatible settings (used when MODEL_PROVIDER=openai)
# Works with OpenAI, DeepSeek (https://api.deepseek.com), and other compatible providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
